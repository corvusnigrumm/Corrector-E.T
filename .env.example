# =============================================================
# CORRECTOR EDITORIAL CORVUS NIGRUM — Variables de Entorno
# =============================================================
# Copia este archivo como .env y rellena los valores.
# NUNCA subas el .env a GitHub.

# --- REQUERIDA (sin esto el corrector IA no funciona) ---
GROQ_API_KEY=gsk_TU_CLAVE_AQUI

# --- Opcionales (tienen valores por defecto) ---

# Modelo de Groq a usar. Opciones disponibles gratis:
#   qwen/qwen3-8b          (rápido, gratuito)
#   qwen/qwen3-32b         (más preciso)
#   llama-3.3-70b-versatile (alternativa)
GROQ_MODEL=qwen/qwen3-8b

# Intervalo de sondeo en segundos (mínimo 60 recomendado)
CRAWL_INTERVAL_SECONDS=90

# Puerto del dashboard (Render lo inyecta automáticamente como $PORT)
DASHBOARD_PORT=5000
